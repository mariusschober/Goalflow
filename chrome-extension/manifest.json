{
  "manifest_version": 3,
  "name": "Goalflow — Execution Companion",
  "version": "0.1.0",
  "description": "Browser-native commitment execution. Current-first, ACTION, focus timer — durable across restarts.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "alarms"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Goalflow — Current",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
