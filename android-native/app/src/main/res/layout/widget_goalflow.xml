<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TODAY"
        android:textColor="@color/goalflow_green"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_done_count"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/goalflow_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="1"
            android:progress="0"
            android:progressTint="@color/goalflow_green"
            android:secondaryProgressTint="@color/goalflow_widget_track" />

        <TextView
            android:id="@+id/widget_total_count"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/goalflow_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_current_task"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:text="Nothing scheduled right now"
        android:textColor="@color/goalflow_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_complete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Complete current task"
            android:minWidth="48dp"
            android:text="✓"
            android:textSize="20sp" />

        <Button
            android:id="@+id/widget_skip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Skip current task"
            android:minWidth="48dp"
            android:text="→"
            android:textSize="20sp" />

        <Button
            android:id="@+id/widget_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Add a task"
            android:minWidth="48dp"
            android:text="+"
            android:textSize="22sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_undo"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:contentDescription="Undo widget completion"
        android:text="Undo completion"
        android:visibility="gone" />
</LinearLayout>
